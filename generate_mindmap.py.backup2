            {name: "+2 Rhythm-Maker's Drum", category: "magic", weight: 3, cost: "Rare", type: "magic", attunement: false, description: "While holding this drum, you gain a +2 bonus to spell attack rolls and to the saving throw DCs of your bard spells. As an action, you can play the drum to regain one use of your Bardic Inspiration feature. This property of the drum can't be used again until the next dawn.", source: "TCE", rarity: "Rare"},
