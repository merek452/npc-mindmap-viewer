            {name: "+2 Wand of the War Mage", category: "magic", weight: 1, cost: "Rare", type: "magic", attunement: false, description: "While you are holding this wand, you gain a +2 bonus to spell attack rolls. In addition, you ignore when making a spell attack.", source: "DMG", rarity: "Rare"},
